# ============================================================================
# Our Free Model —— 生产环境变量示例
# ============================================================================
#
# 用法：
#   Docker Compose ：复制为 deploy/env/ofm.env（compose 文件已声明 env_file，
#                    路径相对 compose 文件所在目录）。该文件已被 .dockerignore
#                    排除，不会被烤进镜像。
#   裸机 / systemd ：写入 /etc/default/ofm（由 unit 的 EnvironmentFile=- 加载，
#                    加载顺序在所有 Environment= 之后，因此此文件优先生效）。
#                    权限建议 0640 root:ofm。
#
# 重要：本文件含敏感信息（API Key、第三方凭据），
#      请勿提交到版本库，备份时务必加密。
# ============================================================================


# ============================================================================
# 一、数据目录（最重要，必读）
# ============================================================================
#
# 目录内含明文凭据，必须持久化到宿主机卷 / 独立分区，且仅本服务可读。
#
# 内容清单（决定了你需要备份哪些东西）：
#   settings.json              服务设置 + 本服务下发的 API Key
#   service.lock               单实例锁（异常退出会残留，启动脚本自动清理）
#   channel-credentials.json   13 个账号渠道的登录凭据
#   eac-user.json              EAC 授权信息
#   channel-pack/codearts-cache/   CodeArts 能力缓存（可用 OFM_CODEARTS_CACHE_DIR 重定向）
#   egress/mihomo.yaml         出网代理配置（若启用）
#   <DSH_HOME>/cache/opencode-capabilities.json   渠道能力缓存
#   <DSH_HOME>/openai-gateway/api-key             渠道侧 API Key 缓存
#
# ⚠ 后两项默认落在 ~/.dsh，在「只读根文件系统」部署下会写失败。
#   因此容器 entrypoint 与 systemd unit 都已把 DSH_HOME 指向本数据目录，
#   此处显式声明是为了让裸机手工启动（不经 entrypoint）同样正确。
#
OFM_HOME=/data

# 渠道能力缓存根目录。留空 = 跟随 OFM_HOME（推荐）。
# 仅当你想把缓存放到别的分区时才显式设置。
# DSH_HOME=/data


# ============================================================================
# 二、端口
# ============================================================================
#
# 服务端口，默认 18900。被占用时自动顺延到下一个可用端口，并把最终端口
# 写回 settings.json 的 standalonePort。
#
# ⚠ 端口漂移是运维陷阱：反向代理写死了 18900 而后端实际跑在 18901，
#   表现为持续 502。部署脚本已做两件事：
#     - entrypoint.sh：启动后回读 settings.json，若漂移则报警并让健康检查失败；
#     - wait-ready.sh ：就绪探测失败时打印 diagnostics.sh 提示。
#   若你希望彻底避免漂移，请确保 18900 在部署前是空闲的。
#
OFM_PORT=18900

# 容器内 nginx 监听端口（仅 Docker 场景使用；裸机请用 deploy/nginx/ofm.conf）
# 发布到宿主机时必须绑回环：127.0.0.1:8080:8080，不要写 0.0.0.0。
# OFM_PROXY_PORT=8080


# ============================================================================
# 三、启动行为
# ============================================================================
#
# 追加给 cli.mjs 的参数（空格分隔，会被不加引号地展开）。
#
#   --no-refresh   跳过启动刷新与周期性刷新（手动刷新与推理仍可用）
#                  → 服务器首次部署推荐，避免启动即打上游、拖慢就绪时间
#   --probe        启用自动可用性探测（会产生真实上游推理请求，每 15 分钟一次）
#                  → 会消耗上游免费额度，按需开启
#   --data-dir <p> 指定数据目录（与 OFM_HOME 等价，二者都给时命令行优先）
#
# OFM_EXTRA_ARGS=--no-refresh

# 容器 entrypoint 就绪探测超时（秒）。超过则退出并让编排层重启。
# 慢速服务器（上游抖动、首次拉取渠道能力）可调大到 90～120。
# OFM_STARTUP_TIMEOUT=60

# 容器 entrypoint 优雅停机等待上限（秒）。
# 必须小于 docker-compose 的 stop_grace_period，否则会先被 SIGKILL。
# 当前 compose 值 40s，此处 25s，留 15s 给 nginx 与日志刷盘。
# OFM_STOP_TIMEOUT=25


# ============================================================================
# 四、Node 运行时
# ============================================================================
#
# ⚠ 关键：V8 的默认堆上限不感知 cgroup 限额。
#   在本机实测（Node 22.22.2，x64）：
#     未设置  → heap_size_limit = 4144 MiB
#     设 1024  → heap_size_limit = 1072 MiB
#   也就是说，在一个 2GB 内存的容器里，Node 默认仍会尝试申请约 4.1GB 堆，
#   结果是进程被内核 OOM Killer 杀掉（退出码 137）——而日志里什么都看不到。
#   因此必须显式设置，取值建议 = 容器内存限额的一半左右。
#
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1024

# Undici（Node 内置 HTTP 客户端）的 WASM SIMD 开关。
# 某些老 CPU 或受限容器不支持 WASM SIMD，会导致上游请求初始化失败。
# 现象：所有渠道请求立刻报错，堆栈里出现 undici / wasm。
# 处置：设为 1 强制关闭，回退到非 SIMD 路径（性能略降，但可用）。
# UNDICI_NO_WASM_SIMD=1


# ============================================================================
# 五、出网代理
# ============================================================================
#
# Gemini / Cline 等渠道会读取标准代理变量。仅 IPv4 回环地址不要走代理。
# 若渠道直连失败而服务器本身需要代理出网，请在这里配置。
#
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,::1


# ============================================================================
# 六、渠道行为开关（可选，按需开启）
# ============================================================================
#
# —— 超时与韧性 ——
# 以下均有内置默认值，一般无需修改。取值单位毫秒。
# 上游不稳定、频繁出现「首包超时」或「中途断流」时可适当放大。
#
# DSH_TRAE_SSE_FIRST_TOKEN_TIMEOUT_MS=120000
# DSH_TRAE_SSE_CHUNK_TIMEOUT_MS=120000
# DSH_CODEARTS_SSE_FIRST_TOKEN_TIMEOUT_MS=300000
# DSH_CODEARTS_SSE_CHUNK_TIMEOUT_MS=600000
# DSH_QODER_SSE_FIRST_TOKEN_TIMEOUT_MS=120000
# DSH_QODER_SSE_CHUNK_TIMEOUT_MS=120000
# DSH_QODER_QUEUE_TIMEOUT_MS=          # 队列等待上限
# DSH_CLINE_SSE_FIRST_TOKEN_TIMEOUT_MS=120000
# DSH_CLINE_SSE_CHUNK_TIMEOUT_MS=120000
# DSH_BUDDY_SSE_FIRST_TOKEN_TIMEOUT_MS=120000
# DSH_BUDDY_SSE_CHUNK_TIMEOUT_MS=120000
# DSH_LOBSTERAI_SSE_FIRST_TOKEN_TIMEOUT_MS=120000
# DSH_LOBSTERAI_SSE_CHUNK_TIMEOUT_MS=120000
# DSH_LOOMY_FIRST_TOKEN_TIMEOUT_MS=
# DSH_LOOMY_CHUNK_TIMEOUT_MS=
# DSH_RACCOON_FIRST_TOKEN_TIMEOUT_MS=
# DSH_RACCOON_CHUNK_TIMEOUT_MS=
# DSH_ZCODE_REQUEST_TIMEOUT_MS=
# DSH_ZCODE_SSE_IDLE_TIMEOUT_MS=
#
# —— 输出净化（防止上游把思维链/课程内容泄漏给调用方）——
# 默认由代码内策略决定，生产建议保持默认。
# DSH_THINK_LEAK_STRIP=1
# DSH_COURSE_LEAK_STRIP=1
# DSH_REASONING_LOOP_GUARD=1
#
# —— 模型列表呈现 ——
# DSH_HIDE_MODELS_WITHOUT_ACCOUNT=1   # 隐藏未接入账号的模型（默认隐藏）
# DSH_DEAD_MODEL_TTL_DAYS=7           # 模型被判定「死亡」后的保留天数
# DSH_TRAE_CHANNELS=                  # 自定义 Trae 渠道列表
# DSH_TRAE_HIDE_INTERNAL=1            # 隐藏内部模型
# DSH_TRAE_MAX_MODE=                  # 是否启用 max 模式
# DSH_TRAE_MAX_MODELS=                # 允许 max 模式的模型白名单
# DSH_TRAE_MAX_COMPLETION_TOKENS=     # 覆盖 max_tokens 上限


# ============================================================================
# 七、第三方渠道凭据（本仓库已移除上游硬编码凭据，需要时自行配置）
# ============================================================================
#
# 未配置时对应渠道不可用，其余渠道不受影响。
# 详见 docs/COMPLIANCE.md 第 6 节。
#
# Loomy（讯飞）：OFM_LOOMY_ACCESS_KEY_ID / OFM_LOOMY_ACCESS_KEY_SECRET
# Raccoon（小浣熊）：OFM_RACCOON_PHONE_CIPHER_SECRET
# Gemini 渠道：CMDC_PAK_GOOGLE_CLIENT_ID / CMDC_PAK_GOOGLE_CLIENT_SECRET
#
# Qoder 运行时信息（通常无需手工设置，程序会自行探测与落盘）：
# QODER_RUNTIME_INFO=
# QODER_MACHINE_TOKEN_PATH=
